{
  "name": "meta-ads-cli",
  "version": "0.2.0",
  "description": "A standalone CLI for Meta Ads (Facebook/Instagram) via the Graph API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "meta-ads": "dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e"
  },
  "keywords": [
    "meta",
    "facebook",
    "instagram",
    "ads",
    "cli",
    "graph-api",
    "advertising"
  ],
  "license": "CC-BY-NC-4.0",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "commander": "^11.1.0",
    "dotenv": "^17.3.1",
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.15",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
